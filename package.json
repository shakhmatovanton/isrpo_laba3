{
  "name": "quick-commit",
  "displayName": "Quick Commit",
  "description": "Quick commit current file from command palette",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
      "commands": [
          {
              "command": "quickCommit.commit",
              "title": "Quick Commit: commit current file"
          }
      ],
      "keybindings": [
          {
              "command": "quickCommit.commit",
              "key": "ctrl+alt+c",
              "mac": "cmd+alt+c",
              "when": "editorTextFocus"
          }
      ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.x",
    "typescript": "^5.3.0"
  }
}
